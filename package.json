{
  "name": "@digitalbazaar/vc-recognized-entities",
  "version": "0.1.0-0",
  "description": "Recognition validation and discovery for VC Recognized Entities v1.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": "./lib/index.js",
  "files": [
    "lib/**/*.js"
  ],
  "scripts": {
    "test": "npm run test-node",
    "test-node": "cross-env NODE_ENV=test mocha --preserve-symlinks -t 30000 -R ${REPORTER:-spec} tests/*.spec.js",
    "coverage": "cross-env NODE_ENV=test c8 npm run test-node",
    "coverage-ci": "cross-env NODE_ENV=test c8 --reporter=lcovonly --reporter=text-summary --reporter=text npm run test-node",
    "coverage-report": "c8 report",
    "lint": "eslint --ext .cjs,.js ."
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-digitalbazaar": "^5.2.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "mocha": "^10.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalbazaar/vc-recognized-entities"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vc",
    "verifiable credential",
    "recognized entity",
    "trust list",
    "VC Recognized Entities"
  ],
  "dependencies": {
    "@digitalbazaar/credentials-context": "3.2.0",
    "@digitalbazaar/data-integrity": "2.5.0",
    "@digitalbazaar/data-integrity-context": "2.0.1",
    "@digitalbazaar/ed25519-multikey": "1.3.1",
    "@digitalbazaar/eddsa-jcs-2022-cryptosuite": "1.0.0",
    "@digitalbazaar/vc": "7.1.1"
  }
}
